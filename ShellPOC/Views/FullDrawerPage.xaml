<?xml version="1.0" encoding="utf-8"?>
<views:Drawer xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:views="clr-namespace:ShellPOC.Views"
              xmlns:viewmodels="clr-namespace:ShellPOC.ViewModels"
              x:DataType="viewmodels:FullDrawerViewModel"
              x:Class="ShellPOC.Views.FullDrawerPage"
              x:TypeArguments="viewmodels:FullDrawerViewModel"
              CloseButton="True"
              CloseOnSwipe="True"
              Shell.NavBarIsVisible="False">
    <ContentPage.Content>
        <VerticalStackLayout Grid.Row="1" BackgroundColor="LightGray">
            <Label
                HorizontalOptions="Center"
                Text="Full Drawer Page"
                VerticalOptions="Center" />
        </VerticalStackLayout>
    </ContentPage.Content>
</views:Drawer>