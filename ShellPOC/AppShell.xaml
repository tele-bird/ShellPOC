<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShellPOC.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:ShellPOC.Helpers"
    xmlns:views="clr-namespace:ShellPOC.Views"
    xmlns:viewmodels="clr-namespace:ShellPOC.ViewModels"
    Title="ShellPOC"
    x:DataType="viewmodels:AppShellViewModel"
    FlyoutBehavior="Disabled"
    x:Name="ThisShell"
    NavBarHasShadow="True">
    <Shell.TitleView>
        <HorizontalStackLayout HorizontalOptions="Center">
            <!-- <Label Text="{Binding CurrentState,Source={x:Reference ThisShell}}"/> -->
            <Label VerticalOptions="Center">
                <Label.Text>
                    <MultiBinding StringFormat="{}{0}?marketId={1}">
                        <Binding Path="CurrentState.Location" Source="{x:Reference ThisShell}"/>
                        <Binding Path="MarketId" TargetNullValue="null"/>
                    </MultiBinding>
                </Label.Text>
            </Label>
        </HorizontalStackLayout>
    </Shell.TitleView>
    <ShellItem>
        <ShellContent ContentTemplate="{DataTemplate views:LandingPage}" Route="landing"/>
    </ShellItem>
    <TabBar Route="market">
        <ShellContent Route="home" Title="Home" ContentTemplate="{DataTemplate views:MarketHomePage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="Juniper"
                    Size="{x:Static helpers:FontHelper.TabsIconSize}"
                    Color="Blue"
                    Glyph="{x:Static helpers:FontHelper.JuniperIconHome1}"/>
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Route="brands" Title="Brands" ContentTemplate="{DataTemplate views:MarketBrandsPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="Juniper"
                    Size="{x:Static helpers:FontHelper.TabsIconSize}"
                    Color="Blue"
                    Glyph="{x:Static helpers:FontHelper.JuniperIconSearchDir}"/>
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Route="plan" Title="Plan" ContentTemplate="{DataTemplate views:MarketPlanPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="Juniper"
                    Size="{x:Static helpers:FontHelper.TabsIconSize}"
                    Color="Blue"
                    Glyph="{x:Static helpers:FontHelper.JuniperIconPlan}"/>
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Route="maps" Title="Maps" ContentTemplate="{DataTemplate views:MarketMapsPage}">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="Juniper"
                    Size="{x:Static helpers:FontHelper.TabsIconSize}"
                    Color="Blue"
                    Glyph="{x:Static helpers:FontHelper.JuniperIconMap}"/>
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>

